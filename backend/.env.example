PORT=3124
MONGODB_URI=mongodb://localhost:27017/pathly
# Optional. Enables the redirect cache and shared rate-limit counters
REDIS_URL=redis://localhost:6379
# Optional. Comma-separated allowed origins (unset = allow all)
CORS_ORIGIN=http://localhost:5173
# Set to 1 when deployed behind a single proxy (Render, Railway, Fly)
TRUST_PROXY=0
LOG_LEVEL=info
CACHE_TTL_SECONDS=3600
SHORTEN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=100
